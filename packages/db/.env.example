# Copy to packages/db/.env for local development. Never commit real values.

# `pnpm db:setup:local`: administrator connection to the LOCAL Supabase database started by
# `pnpm supabase:start` (the CLI's fixed local credentials; the script refuses non-local hosts).
LOCAL_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Password the setup script gives the local app_runtime role (use the same value in the API's
# DATABASE_URL). 16-128 characters of letters, digits, "_" or "-". Generate one, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
APP_RUNTIME_PASSWORD=

# `pnpm db:migrate` (any environment): connection as Supabase's `postgres` role (ADR 0022). In
# deployed environments it comes from AWS Secrets Manager in the deploy pipeline, never a file.
MIGRATOR_DATABASE_URL=
