{
  "name": "spiritualhealing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && pnpm --parallel --filter @spiritualhealing/api --filter @spiritualhealing/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "pnpm --filter @spiritualhealing/api test:integration",
    "test:e2e": "pnpm --filter @spiritualhealing/web test:e2e",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:setup:local": "pnpm --filter @spiritualhealing/db db:setup:local",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supabase": "3.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
