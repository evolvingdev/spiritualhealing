# Copy to apps/api/.env for local development. Never commit real values.
# Every variable is validated at startup; the API refuses to start if one is missing or invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on. Optional, default 3001.
PORT=3001

# fatal | error | warn | info | debug | trace | silent. Optional, default info.
LOG_LEVEL=info

# Postgres connection for the least-privilege `app_runtime` role (never a superuser or owner).
# Hosted Supabase: the transaction-mode pooler (port 6543). Local stack: 127.0.0.1:55322 with the
# APP_RUNTIME_PASSWORD from packages/db/.env.
DATABASE_URL=postgres://app_runtime:<password>@<host>:6543/postgres

# Maximum pooled connections per API instance. Optional, default 10.
DATABASE_POOL_MAX=10

# Base URL of the Supabase project. The token issuer and JWKS URL are derived from it.
# Must be https in production. Local stack: http://127.0.0.1:55321
SUPABASE_URL=https://<project-ref>.supabase.co

# The project's publishable (anon) key: identifies the project to Supabase Auth when the API makes
# credential changes with a user's own token. Not secret, but kept out of the browser bundle.
# Local stack: PUBLISHABLE_KEY from `pnpm exec supabase status -o env`.
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Proxies in front of the API whose X-Forwarded-For is trusted, so rate limits see the real client
# IP. Count every hop, including the Next.js server (it forwards the browser's IP): 1 when the web
# server calls the API directly, 2 behind the AWS ALB as well. Optional, default 0.
TRUST_PROXY_HOPS=0
