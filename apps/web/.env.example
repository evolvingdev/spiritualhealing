# Copy to apps/web/.env for local development. Never commit real values.
# All of these are server-only (none is NEXT_PUBLIC_), so none reaches the browser bundle.
# They are validated on first use; the server fails fast on a missing or invalid value.

# The public origin of this site (Supabase email links and OAuth redirects point here).
# Must be https in production.
SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key. Local stack: API_URL and PUBLISHABLE_KEY from
# `pnpm exec supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Where this server reaches our API (server to server; the browser never calls it).
API_INTERNAL_URL=http://127.0.0.1:3001

# Shows "Continue with Google" once a Google OAuth client is set up in Supabase. Optional,
# default false. See docs/environment.md for the Google and Supabase steps.
AUTH_GOOGLE_ENABLED=false
